package agent

import (
	"fmt"
 "encoding/hex"
 "net/url"

	proxyv1 "github.com/soltiHQ/control-plane/api/proxy/v1"
	"github.com/soltiHQ/control-plane/internal/uikit/routepath"
	"github.com/soltiHQ/control-plane/internal/uikit/htmx"
	"github.com/soltiHQ/control-plane/ui/templates/component/card"
	"github.com/soltiHQ/control-plane/ui/templates/component/form"
	"github.com/soltiHQ/control-plane/ui/templates/component/list"
	"github.com/soltiHQ/control-plane/ui/templates/component/status"
	"github.com/soltiHQ/control-plane/ui/templates/component/visual"
	"github.com/soltiHQ/control-plane/ui/templates/jsexpr"
)

// Tasks renders the paginated task table for a specific agent.
templ Tasks(agentID string, items []proxyv1.Task, total int, q string, nextCursor string) {
	@card.Card("") {
		@card.CardHeader() {
			<h2 class={ visual.SectionLabel + " select-none" }>
				Tasks
			</h2>
			<span class="text-[11px] text-muted tabular-nums">
				{ fmt.Sprintf("%d", total) }
			</span>
		}

		@card.CardBody() {
			<div class="mb-4">
				@form.SearchInput(
					"tasks-search",
					"slot",
					q,
					"Filter by exact slot…",
					routepath.ApiAgentTasks(agentID),
					"#tasks-results",
				)
			</div>

			@TaskResults(agentID, items, total, q, nextCursor)
		}
	}
}

// TaskResults is the HTMX-swappable wrapper for task rows + pagination.
// SSE and polling triggers live here (not on the outer panel) so that refreshes
// replace only the results, leaving the search input untouched.
templ TaskResults(agentID string, items []proxyv1.Task, total int, q string, nextCursor string) {
	<div
		id="tasks-results"
		hx-get={ routepath.ApiAgentTasks(agentID) }
		hx-trigger={ htmx.Poll(htmx.GetAgentTasksRefresh(), htmx.AgentUpdate) }
		hx-target="this"
		hx-swap="outerHTML"
		hx-select="#tasks-results"
		hx-include="#tasks-search"
	>
		<div id="tasks-rows" class={ list.StripedClass }>
			@TaskRows(agentID, items)
			if nextCursor != "" {
				@list.Sentinel("tasks-sentinel", tasksURL(agentID, q, nextCursor), "tasks-rows")
			}
		</div>
	</div>
}

// TaskRows renders table rows for a slice of tasks.
templ TaskRows(agentID string, items []proxyv1.Task) {
	if len(items) == 0 {
		@status.NotFound("No tasks found")
	} else {
		for _, t := range items {
			@taskRow(agentID, t)
		}
	}
}

templ taskRow(agentID string, t proxyv1.Task) {
	<div class="px-5 py-3 space-y-1.5">
		<div class="flex items-center justify-between gap-3">
			<div class="flex items-center gap-2 min-w-0">
				@taskStatusBadge(t.Status)
				<span class="text-sm font-medium text-fg truncate">{ t.Slot }</span>
			</div>

			if t.Attempt > 0 {
				<span class="shrink-0 text-[11px] text-muted tabular-nums">
					#{ fmt.Sprintf("%d", t.Attempt) }
				</span>
			}
		</div>

		<div class="text-[11px] font-mono text-muted tracking-wide truncate">
			{ t.ID }
		</div>

		if t.Error != "" {
			<div class="text-xs text-danger/80 break-words leading-snug">
				{ t.Error }
			</div>
		}

		<details id={ inspectorID(agentID,t.UID) } hx-preserve class="mt-2"><summary class="text-xs text-muted cursor-pointer hover:text-fg">Task details and run history</summary><div class="mt-3" hx-get={ routepath.ApiAgentTask(agentID,t.ID) } hx-target="this" hx-select=".task-execution" hx-trigger={ inspectorTrigger(agentID,t.UID) } hx-swap="innerHTML"><p class="text-xs text-muted">Loading task…</p></div></details>
 @TaskLogs(agentID, t.ID, t.UID)
	</div>
}

templ taskStatusBadge(s string) {
	switch s {
		case "running":
			@visual.Badge("running", visual.VariantPrimary) {
				@visual.StatusDot("primary")
			}
		case "succeeded":
			@visual.Badge("succeeded", visual.VariantSuccess)
		case "failed":
			@visual.Badge("failed", visual.VariantDanger)
		case "pending":
			@visual.Badge("pending", visual.VariantMuted)
		case "timeout":
			@visual.Badge("timeout", visual.VariantDanger)
		case "canceled":
			@visual.Badge("canceled", visual.VariantMuted)
		case "exhausted":
			@visual.Badge("exhausted", visual.VariantDanger)
		default:
			@visual.Badge(s, visual.VariantMuted)
	}
}

func tasksURL(agentID,q,cursor string) string {
 return routepath.CursorURL(routepath.ApiAgentTasks(agentID),cursor,"")+"&slot="+url.QueryEscape(q)
}

// Preserve only this resource incarnation, and poll an expanded inspector
// independently of the surrounding task list. IDs also remain safe in filters.
func inspectorID(agentID,uid string) string {
 return "task-inspector-"+hex.EncodeToString([]byte(agentID))+"-"+hex.EncodeToString([]byte(uid))
}

func inspectorTrigger(agentID,uid string) string {
 return "toggle[event.target.open] from:closest details, every 5s [document.getElementById("+jsexpr.String(inspectorID(agentID,uid))+").open]"
}
