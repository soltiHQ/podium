package agent

import (
	restv1 "github.com/soltiHQ/control-plane/api/rest/v1"
	"github.com/soltiHQ/control-plane/internal/uikit/routepath"
	"github.com/soltiHQ/control-plane/ui/templates/component/button"
	"github.com/soltiHQ/control-plane/ui/templates/component/modal"
)

// credentialDialogs renders the two dialogs of "Reset credential". The first
// asks for confirmation and posts to the credential route of the agent. The
// reset answers the new token once, as JSON (credentialIssuedForm), and the
// second dialog shows it with a button to copy it, and for a derived credential
// the command that prints it again. The token lives in the issued state that
// both dialogs share, and nowhere else in the page: the second dialog clears it
// when it closes, by any way of closing, and the page never renders it.
templ credentialDialogs(a restv1.Agent) {
	<div x-data="{ issued: null }">
		@modal.ConfirmWith(
			resetCredentialModal,
			"Reset credential",
			"Issue a new credential for "+a.ID+"? Its current token stops working at once: the agent's syncs are refused until it is given the new token, and podium's calls to it carry the new token. The new token is shown once.",
			"Reset",
			routepath.ApiAgentCredential(a.ID),
			modal.MethodPost,
			modal.VariantDanger,
			credentialIssuedForm(),
		)
		@modal.Modal(credentialIssuedModal) {
			<div x-effect="show || (issued = null)">
				@modal.Body() {
					@modal.Title("New credential")
					@modal.Message("Copy the token now and give it to the agent: it is shown once and cannot be read again.")
					<template x-if="issued">
						<div class="space-y-3 pt-2">
							<div class="flex items-start gap-2">
								<code class="block min-w-0 flex-1 break-all rounded-[var(--r-xs)] border border-border bg-surface-dim p-3 font-mono text-sm text-fg" x-text="issued.token"></code>
								@button.Button("Copy", "button", false, button.VariantSecondary, false,
									templ.Attributes{"data-copy": "", "x-bind:data-copy-text": "issued.token"},
								)
							</div>
							<template x-if="issued.generation">
								<div class="space-y-1">
									<p class="text-xs text-muted">The enrollment secret derives this token again:</p>
									<div class="flex items-start gap-2">
										<code class="block min-w-0 flex-1 break-words rounded-[var(--r-xs)] border border-border bg-surface-dim p-3 font-mono text-xs text-fg" x-text={ derivationLine }></code>
										@button.Button("Copy", "button", false, button.VariantSecondary, false,
											templ.Attributes{"data-copy": "", "x-bind:data-copy-text": derivationLine},
										)
									</div>
								</div>
							</template>
						</div>
					</template>
				}
				@modal.Footer() {
					@button.Button("Close", "button", false, button.VariantPrimary, false,
						templ.Attributes{"x-on:click": "show = false"},
					)
				}
			</div>
		}
	</div>
}

// deleteDialog renders the confirmation of "Delete agent", which lists what
// goes and what stays, and says what an agent that still runs does.
templ deleteDialog(a restv1.Agent) {
	@modal.Confirm(
		deleteAgentModal,
		"Delete agent",
		"Delete "+a.ID+"?",
		"Delete",
		routepath.ApiAgentByID(a.ID),
		modal.MethodDelete,
		modal.VariantDanger,
	) {
		<div class="space-y-2 pt-2 text-sm text-muted-strong">
			<p class="font-medium text-fg">Goes</p>
			<ul class="list-disc space-y-1 pl-5">
				<li>the agent: its name, labels, endpoint and runner inventory;</li>
				<li>every rollout of the agent: podium stops managing the tasks it installed there, which keep running on the agent.</li>
			</ul>
			<p class="font-medium text-fg">Stays</p>
			<ul class="list-disc space-y-1 pl-5">
				<li>the agent's credential: the token it presents stays valid;</li>
				<li>its execution history.</li>
			</ul>
			<p>An agent that still runs registers again at its next sync with its credential, without labels and without rollouts. To keep it out, reset its credential first.</p>
		</div>
	}
}
