package spec

import (
	"fmt"
	restv1 "github.com/soltiHQ/control-plane/api/rest/v1"
	"github.com/soltiHQ/control-plane/internal/uikit/routepath"
	"github.com/soltiHQ/control-plane/ui/templates/component/card"
	"github.com/soltiHQ/control-plane/ui/templates/component/visual"
	"sort"
	"strings"
	"time"
)

// Placement renders the shared Deploy planner's observation of the saved spec.
// Eligibility is routing compatibility, not an execution or health guarantee.
// data-plan-token holds the plan token that the Deploy dialog sends as If-Match;
// x-init copies it onto the panel's container (see keepPlanTokenExpr).
templ Placement(plan restv1.SpecPlacement) {
	<section class="placement-preview space-y-3" aria-label="Placement preview" data-plan-token={ plan.PlanToken } x-init={ keepPlanTokenExpr() }>
		@card.Card("") {
			@card.CardBody() {
				<div class="flex items-center justify-between gap-3 flex-wrap">
					<h3 class={ visual.SectionTitle }>Placement preview</h3>
					<button type="button" class="text-xs text-primary hover:text-primary/80" hx-get={ routepath.ApiSpecPlacement(plan.SpecID) } hx-target="#spec-placement" hx-swap="innerHTML">Refresh preview</button>
				</div>
				<div class="flex items-center gap-2 flex-wrap mt-3">
					@visual.Badge(fmt.Sprintf("saved v%d · gen %d", plan.SpecVersion, plan.Generation), visual.VariantMuted)
					@visual.Badge(fmt.Sprintf("%d targets", len(plan.Targets)), visual.VariantMuted)
					if plan.DeployAllowed {
						@visual.Badge("Deployment may be requested", visual.VariantPrimary)
					} else {
						@visual.Badge("Deployment blocked", visual.VariantDanger)
					}
				</div>
				<p class="text-xs text-muted mt-3">Calculated { placementTime(plan.CheckedAt) } from the saved spec and observed discovery inventory. Unsaved edits are excluded. Deploy checks placement again; this preview does not reserve capacity or confirm execution.</p>
				if plan.BlockingReason!="" {
					<p class="text-xs text-danger mt-3">{ placementBlockingReason(plan.BlockingReason) }</p>
				}
				if plan.NoTargets && !plan.DeletionRequested {
					<p class="text-xs text-warning mt-3">No agents match the saved selectors. Deploy removes existing rollout tasks for this spec.</p>
				}
				<p class="text-xs text-muted mt-3">Agent status and heartbeat freshness are stored observations, not active health checks. Inactive or overdue agents can receive desired state; compatible routing does not guarantee reachability or successful runner construction.</p>
			}
		}
		for _,target:=range plan.Targets {
			@card.Card("") {
				@card.CardBody() {
					<div class="flex items-start justify-between gap-3 flex-wrap">
						<div class="min-w-0">
							if target.Exists {
								<a class="text-sm font-medium text-primary hover:underline break-words" href={ templ.SafeURL(routepath.PageAgentInfoByID(target.AgentID)) }>{ placementAgentName(target) }</a>
							} else {
								<h4 class="text-sm font-medium break-words">{ target.AgentID }</h4>
							}
							<p class="text-[11px] font-mono text-muted break-words">{ target.AgentID }</p>
							<p class="text-xs text-muted mt-1">Matched by: { strings.Join(target.MatchedBy,", ") }</p>
						</div>
						@visual.Badge(placementEligibilityLabel(target), placementEligibilityVariant(target))
					</div>
					<p class="text-xs mt-3 break-words">{ placementTargetReason(target.EligibilityReason) }</p>
					if target.Exists {
						<dl class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs mt-3">
							@visual.KV("Observed agent status", target.Status)
							@visual.KV("Heartbeat freshness", target.HeartbeatFreshness)
							@visual.KV("Last seen", placementTime(target.LastSeenAt))
							@visual.KV("Heartbeat due", placementTime(target.HeartbeatDueAt))
							if target.SelectedRunner!="" {
								@visual.KV("First compatible runner", target.SelectedRunner)
							}
						</dl>
					}
					if len(target.Runners)>0 {
						<h5 class="text-xs font-medium mt-4">Runner registration order</h5>
						<p class="text-xs text-muted mt-1">The first compatible registration is selected. Each runner must support the workload and match every runner label requirement.</p>
						<ol class="space-y-2 mt-3">
							for i,runner:=range target.Runners {
								<li class="rounded border border-border p-3 space-y-1">
									<div class="flex items-center gap-2 flex-wrap">
										<span class="text-xs font-medium break-words">{ fmt.Sprintf("%d. %s",i+1,runner.Name) }</span>
										if runner.Eligible {
											@visual.Badge("Compatible", visual.VariantPrimary)
										} else {
											@visual.Badge("Excluded", visual.VariantMuted)
										}
									</div>
									<p class="text-xs">{ placementRunnerReason(runner.Reason) }</p>
									<p class="text-xs text-muted">Workload match: { placementMatch(runner.WorkloadMatch) } · label match: { placementMatch(runner.LabelsMatch) }</p>
									if len(runner.Labels)>0 {
										<p class="text-[11px] font-mono text-muted break-words">{ placementLabels(runner.Labels) }</p>
									}
								</li>
							}
						</ol>
					}
				}
			}
		}
	</section>
}

func placementTime(value string) string {
	if value == "" {
		return "Not reported"
	}
	parsed, err := time.Parse(time.RFC3339Nano, value)
	if err != nil {
		return value
	}
	return parsed.UTC().Format("2006-01-02 15:04:05 UTC")
}
func placementAgentName(t restv1.PlacementTarget) string {
	if t.AgentName != "" {
		return t.AgentName
	}
	return t.AgentID
}
func placementEligibilityLabel(t restv1.PlacementTarget) string {
	if !t.Eligible {
		return "Placement blocked"
	}
	if !t.InventoryKnown {
		return "Runner inventory unknown"
	}
	return "Routing compatible"
}
func placementEligibilityVariant(t restv1.PlacementTarget) visual.Variant {
	if !t.Eligible {
		return visual.VariantDanger
	}
	if !t.InventoryKnown {
		return visual.VariantMuted
	}
	return visual.VariantPrimary
}
func placementBlockingReason(reason string) string {
	switch reason {
	case "spec_deleting":
		return "This spec is being deleted; a new deployment cannot be requested."
	case "unknown_targets":
		return "At least one explicit target agent is missing. The deployment is blocked for every target."
	case "unsupported_targets":
		return "At least one target has no compatible runner. The deployment is blocked for every target."
	default:
		return reason
	}
}
func placementTargetReason(reason string) string {
	switch reason {
	case "missing_agent":
		return "The explicit agent ID is not present in discovery inventory."
	case "inventory_unknown":
		return "No runner inventory has been advertised. Desired state can be committed, but runner compatibility is unknown."
	case "workload_unsupported":
		return "The advertised runners do not support this workload group, version and kind."
	case "runner_labels_mismatch":
		return "The workload is supported, but no runner matches every required runner label."
	case "compatible_runner":
		return "A compatible runner is advertised for this saved desired state."
	default:
		return reason
	}
}
func placementRunnerReason(reason string) string {
	switch reason {
	case "workload_unsupported":
		return "This registration does not support the required workload."
	case "runner_labels_mismatch":
		return "This registration does not match all required runner labels."
	case "compatible":
		return "This registration matches both workload and runner labels."
	default:
		return reason
	}
}
func placementMatch(match bool) string {
	if match {
		return "yes"
	}
	return "no"
}
func placementLabels(labels map[string]string) string {
	keys := make([]string, 0, len(labels))
	for k := range labels {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	pairs := make([]string, 0, len(keys))
	for _, k := range keys {
		pairs = append(pairs, k+"="+labels[k])
	}
	return strings.Join(pairs, ", ")
}
